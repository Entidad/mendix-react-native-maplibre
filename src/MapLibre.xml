<?xml version="1.0" encoding="utf-8"?>
<widget id="entidad.io.native.maplibre.MapLibre" pluginWidget="true" needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Native"
    xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Map Libre</name>
    <description>Display maps inside your native app with MapLibre Native (https://maplibre.org/).</description>
    <icon>
        </icon>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Map">
                <property key="mapStyle" type="attribute" required="false">
                    <caption>Map style</caption>
                    <description>The attribute that contains the URL or style JSON for the map style. See https://maplibre.org/maplibre-react-native/docs/components/general/map-view</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="clusterFont" type="string" defaultValue="Noto Sans Bold">
                    <caption>Cluster label font</caption>
                    <description>Font for cluster counts. Must be a font served by the map style's glyphs, e.g. "Noto Sans Bold" for MapTiler or "Open Sans Semibold" for the MapLibre demo tiles.</description>
                </property>
                <property key="showClusterToggle" type="boolean" defaultValue="true">
                    <caption>Show clustering toggle</caption>
                    <description>Shows a button in the top right corner to switch between grouped (clustered) and all markers. Only shown when a marker layer has clustering on.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Popup">
                <property key="popupVisible" type="attribute" required="false">
                    <caption>Popup visible</caption>
                    <description>Optional Boolean attribute kept in sync with the marker popup: set to true when a marker is tapped, and the popup closes when it is set to false. Use it to close the popup from a button inside the popup content.</description>
                    <attributeTypes>
                        <attributeType name="Boolean" />
                    </attributeTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Attribution">
                <property key="showAttribution" type="boolean" defaultValue="true">
                    <caption>Show attribution button</caption>
                    <description>Shows the (i) button that opens the attribution dialog built from the map style's sources.</description>
                </property>
                <property key="attributionPosition" type="enumeration" defaultValue="bottomRight">
                    <caption>Attribution position</caption>
                    <description>Corner for the attribution button and text.</description>
                    <enumerationValues>
                        <enumerationValue key="bottomRight">Bottom right</enumerationValue>
                        <enumerationValue key="bottomLeft">Bottom left</enumerationValue>
                        <enumerationValue key="topRight">Top right</enumerationValue>
                        <enumerationValue key="topLeft">Top left</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="attributionText" type="textTemplate" required="false">
                    <caption>Attribution text</caption>
                    <description>Optional credit line that is always visible on the map, e.g. "© MapTiler © OpenStreetMap contributors".</description>
                </property>
                <property key="tintColor" type="string" required="false">
                    <caption>Tint color</caption>
                    <description>Optional color for the map's buttons, such as the attribution button, e.g. #1C7D77.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Markers">
                <property key="markerLayers" type="object" isList="true" required="false">
                    <caption>Marker layers</caption>
                    <description>Each layer shows the objects of one data source on the map, with its own icon and popup.</description>
                    <properties>
                        <propertyGroup caption="Data">
                            <propertyGroup caption="Data source">
                                <property key="markers" type="datasource" isList="true" required="true">
                                    <caption>Data source</caption>
                                    <description>The marker objects: from the database, over an association, or returned by a nanoflow.</description>
                                </property>
                                <property key="latitude" type="attribute" dataSource="markers" required="true">
                                    <caption>Latitude</caption>
                                    <description>Number from -90.0 to 90.0. Objects without a valid coordinate are skipped.</description>
                                    <attributeTypes>
                                        <attributeType name="Decimal" />
                                        <attributeType name="Integer" />
                                        <attributeType name="Long" />
                                        <attributeType name="String" />
                                    </attributeTypes>
                                </property>
                                <property key="longitude" type="attribute" dataSource="markers" required="true">
                                    <caption>Longitude</caption>
                                    <description>Number from -180.0 to 180.0. Objects without a valid coordinate are skipped.</description>
                                    <attributeTypes>
                                        <attributeType name="Decimal" />
                                        <attributeType name="Integer" />
                                        <attributeType name="Long" />
                                        <attributeType name="String" />
                                    </attributeTypes>
                                </property>
                            </propertyGroup>
                        </propertyGroup>
                        <propertyGroup caption="Appearance">
                            <propertyGroup caption="Icon">
                                <property key="markerIcon" type="image" required="false">
                                    <caption>Icon</caption>
                                    <description>Static image from an image collection, bundled with the app. A PNG is recommended. When empty, a default dot is shown.</description>
                                </property>
                                <property key="iconSize" type="integer" defaultValue="32">
                                    <caption>Icon size</caption>
                                    <description>Size of the icon's largest side, in points.</description>
                                </property>
                                <property key="iconAnchor" type="enumeration" defaultValue="bottom">
                                    <caption>Icon anchor</caption>
                                    <description>Which part of the icon sits on the coordinate. Use Bottom for pin-shaped icons, Center for round ones.</description>
                                    <enumerationValues>
                                        <enumerationValue key="bottom">Bottom</enumerationValue>
                                        <enumerationValue key="center">Center</enumerationValue>
                                    </enumerationValues>
                                </property>
                            </propertyGroup>
                            <propertyGroup caption="Clustering">
                                <property key="cluster" type="boolean" defaultValue="false">
                                    <caption>Cluster markers</caption>
                                    <description>Groups nearby markers into a bubble showing their count. Tapping a bubble zooms in until it splits.</description>
                                </property>
                                <property key="clusterRadius" type="integer" defaultValue="50">
                                    <caption>Cluster radius</caption>
                                    <description>How close markers must be to merge, in points. Larger values make fewer, bigger clusters.</description>
                                </property>
                                <property key="clusterColor" type="string" defaultValue="#1C7D77">
                                    <caption>Cluster color</caption>
                                    <description>Bubble color, e.g. match it to this layer's icon.</description>
                                </property>
                                <property key="spreadOverlapping" type="boolean" defaultValue="true">
                                    <caption>Spread markers at the same location</caption>
                                    <description>Markers with exactly the same coordinates are fanned out in a small circle (about 100-200 m) so each can be seen and tapped. Turn off when exact positions matter more.</description>
                                </property>
                            </propertyGroup>
                        </propertyGroup>
                        <propertyGroup caption="Popup">
                            <propertyGroup caption="Popup">
                                <property key="popupHeader" type="widgets" dataSource="markers" required="false">
                                    <caption>Popup header</caption>
                                    <description>Optional content pinned to the top of the popup, e.g. a title and close button. It stays in place while the popup content scrolls.</description>
                                </property>
                                <property key="popupContent" type="widgets" dataSource="markers" required="false">
                                    <caption>Popup content</caption>
                                    <description>Content shown in a popup when a marker is tapped; it scrolls when taller than the screen. When both header and content are empty, no popup is shown.</description>
                                </property>
                            </propertyGroup>
                        </propertyGroup>
                        <propertyGroup caption="Events">
                            <propertyGroup caption="Events">
                                <property key="onMarkerClick" type="action" dataSource="markers" required="false">
                                    <caption>On marker click</caption>
                                    <description>Action to run with the tapped marker object.</description>
                                </property>
                            </propertyGroup>
                        </propertyGroup>
                    </properties>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="onClose" type="action" required="false">
                <caption>On close</caption>
                <description>Action for the close button in the top left corner, typically "Close page". The button is hidden when no action is set.</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
